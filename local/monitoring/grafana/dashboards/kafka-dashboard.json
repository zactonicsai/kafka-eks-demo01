{
  "annotations": { "list": [] },
  "title": "Kafka Message Tracking",
  "uid": "kafka-msg-tracking",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Total Messages Produced (app)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } } },
      "targets": [
        {
          "expr": "sum(messages_produced_total)",
          "legendFormat": "produced"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Messages Consumed (app)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(messages_consumed_total)",
          "legendFormat": "consumed"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "App Message Rate (produced vs consumed /s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(messages_produced_total[1m]))",
          "legendFormat": "produced/s"
        },
        {
          "expr": "sum(rate(messages_consumed_total[1m]))",
          "legendFormat": "consumed/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Broker Messages In /s (per topic)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_server_brokertopicmetrics_messagesin_total[1m]))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Broker Bytes In/Out /s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(kafka_server_brokertopicmetrics_bytesin_total[1m]))",
          "legendFormat": "bytes in/s"
        },
        {
          "expr": "sum(rate(kafka_server_brokertopicmetrics_bytesout_total[1m]))",
          "legendFormat": "bytes out/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "End-to-end Latency (p95, ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(message_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "p95 latency"
        }
      ]
    }
  ]
}
